    signal CRYSTALS_ipd 	: std_logic := 'X';

    component sapiobuf0008
      port (Z: out Std_logic; PAD: in Std_logic);
    end component;
  begin
    CRYSTAL_pad: sapiobuf0008
      port map (Z=>PADDI_out, PAD=>CRYSTALS_ipd);

